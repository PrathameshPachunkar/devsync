# Copy to apps/api/.env for local overrides. Every value here is optional in development.

# Without DATABASE_URL the API runs on embedded PGlite (data in apps/api/.data/pglite).
# To use real Postgres: `docker compose up -d` at the repo root, then uncomment:
# DATABASE_URL=postgres://devsync:devsync@localhost:5432/devsync

PORT=4000
WEB_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Required in production (32+ characters). Development uses a built-in fallback.
# JWT_SECRET=

# "Sign in with GitHub": create an OAuth app with the callback URL
# http://localhost:4000/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Production behind a proxy, with the web app on a sibling subdomain:
# TRUST_PROXY=true
# COOKIE_DOMAIN=.devsync.app
# COOKIE_SECURE=true
