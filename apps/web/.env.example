# Copy to apps/web/.env.local to point the web app at a different API.
# Both values are read at build time.

# Local development: call the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Deployment without a shared domain (e.g. *.vercel.app + *.up.railway.app):
# proxy the API through this site so session cookies are first-party.
# NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=https://your-api.up.railway.app
